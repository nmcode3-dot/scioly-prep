# ─────────────────────────────────────────────────────────────
#  SciOlyPrep — environment variables
#  Copy this file to `.env.local` (for local dev) or set these
#  in your host's dashboard (e.g. Vercel → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# REQUIRED for AI quiz generation — a free Groq API key.
# Get one (no credit card): https://console.groq.com/keys
GROQ_API_KEY=

# OPTIONAL — PostgreSQL connection string.
# The app works WITHOUT a database. If you set this, it's used for nothing
# critical (history is stored in the browser). Set it only if you want to
# experiment with server-side persistence.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# OPTIONAL — override the model (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# OPTIONAL — override the OpenAI-compatible endpoint (defaults to Groq)
# AI_BASE_URL=https://api.groq.com/openai
