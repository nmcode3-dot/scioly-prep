# ─────────────────────────────────────────────────────────────
#  SciOlyBattle — environment variables
#  Set these in your host's dashboard (e.g. Vercel → Settings → Environment
#  Variables) or copy to a local `.env.local` for dev.
# ─────────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL connection string (accounts + battles need a database).
# Local dev:     postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Hosted (Neon): postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
#                 ^ use Neon's POOLED connection string for serverless.
# Tables auto-create on first launch — no migrations needed.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# REQUIRED for battle questions — a free Groq API key.
# Get one (no credit card): https://console.groq.com/keys
GROQ_API_KEY=

# OPTIONAL — override the model (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
